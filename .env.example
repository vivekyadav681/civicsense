# ==============================================================================
# CivicSense Backend - Environment Variables Template
# Copy this file to '.env' and populate with your local/staging/production values
# ==============================================================================

# ------------------------------------------------------------------------------
# SERVER & LOGGING CONFIGURATION
# ------------------------------------------------------------------------------
SERVER_PORT=8080
LOG_LEVEL=DEBUG

# ------------------------------------------------------------------------------
# POSTGRESQL DATABASE CONFIGURATION
# ------------------------------------------------------------------------------
# Individual host/port/name configuration (used by default)
DB_HOST=localhost
DB_PORT=5432
DB_NAME=civicsense_db
DB_USERNAME=postgres
DB_PASSWORD=postgres

# Alternatively, set full JDBC connection string (overrides host/port/name if set)
# DB_URL=jdbc:postgresql://localhost:5432/civicsense_db

# Flyway database migrations: true to execute V*__*.sql scripts automatically
FLYWAY_ENABLED=true

# Hibernate DDL generation: 'validate' (schema is managed exclusively by Flyway)
JPA_DDL_AUTO=validate
JPA_SHOW_SQL=false

# ------------------------------------------------------------------------------
# JWT AUTHENTICATION SECURITY
# ------------------------------------------------------------------------------
# Must be a 256-bit (32-byte) hex or base64 key for HMAC-SHA256
JWT_SECRET=e3b0c44298fc1c149afbf4c8996fb92427ae41e4649b934ca495991b7852b855
# Token expiration time in milliseconds (86400000 = 24 hours)
JWT_EXPIRATION_MS=86400000

# ------------------------------------------------------------------------------
# FILE STORAGE (LOCAL DISK vs AWS S3)
# ------------------------------------------------------------------------------
# Set to 'true' for local development (no AWS credentials required)
# Set to 'false' for production to stream files directly to Amazon S3
USE_LOCAL_STORAGE=true
LOCAL_UPLOAD_DIR=./uploads

# AWS S3 Settings (Required only when USE_LOCAL_STORAGE=false)
AWS_REGION=ap-south-1
S3_BUCKET=civicsense-images
AWS_ACCESS_KEY=your_aws_access_key_here
AWS_SECRET_KEY=your_aws_secret_key_here
# Optional custom base URL (e.g. CloudFront distribution or S3 direct URL)
# S3_BASE_URL=https://civicsense-images.s3.ap-south-1.amazonaws.com

# Upload limits
MAX_FILE_SIZE=10MB
MAX_REQUEST_SIZE=15MB

# ------------------------------------------------------------------------------
# BUSINESS LOGIC & DEDUPLICATION CONFIGURATION
# ------------------------------------------------------------------------------
# Radius in metres to flag nearby open complaints as duplicates
DEDUPLICATION_RADIUS_METRES=50

# Department Names (matches default data.sql seeds)
DEPT_WASTE=Sanitation
DEPT_ROADS=Public Works
DEPT_STREETLIGHTS=Electrical
DEPT_OTHER=General Administration
